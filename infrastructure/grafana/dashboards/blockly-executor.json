
"dashboard": {
  "id": null,
  "uid": "blockly-executor",
  "title": "Blockly Executor - CQRS Metrics",
  "tags": ["blockly", "cqrs", "micrometer"],
  "timezone": "browser",
  "schemaVersion": 36,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Overview",
      "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "title": "Kafka Producer Avg Latency",
      "type": "stat",
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 1},
      "targets": [
        {
          "expr": "rate(spring_kafka_template_seconds_sum{name=\"eventKafkaTemplate\"}[$__rate_interval]) / rate(spring_kafka_template_seconds_count{name=\"eventKafkaTemplate\"}[$__rate_interval]) * 1000",
          "legendFormat": "Avg Latency",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 100},
              {"color": "red", "value": 500}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "DAO Total RPS",
      "type": "stat",
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 1},
      "targets": [
        {
          "expr": "sum(rate(blockly_dao_read_seconds_count[$__rate_interval]))",
          "legendFormat": "DAO Read RPS",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 100},
              {"color": "red", "value": 200}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Kafka Producer RPS",
      "type": "stat",
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 1},
      "targets": [
        {
          "expr": "sum(rate(spring_kafka_template_seconds_count{name=\"eventKafkaTemplate\"}[$__rate_interval]))",
          "legendFormat": "Kafka RPS",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 100},
              {"color": "red", "value": 200}
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "DAO Operations",
      "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 6,
      "title": "Read RPS",
      "type": "timeseries",
      "gridPos": {"h": 5, "w": 12, "x": 0, "y": 6},
      "targets": [
        {
          "expr": "sum(rate(blockly_dao_read_seconds_count[$__rate_interval]))",
          "legendFormat": "Read RPS",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {"mode": "palette-classic"},
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity"
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Write RPS",
      "type": "timeseries",
      "gridPos": {"h": 5, "w": 12, "x": 12, "y": 6},
      "targets": [
        {
          "expr": "sum(rate(blockly_dao_write_seconds_count[$__rate_interval]))",

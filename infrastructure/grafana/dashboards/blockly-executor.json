      "type": "timeseries",
      "gridPos": {"h": 5, "w": 12, "x": 0, "y": 11},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(blockly_dao_read_seconds_bucket[$__rate_interval])))",
          "legendFormat": "Read p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
